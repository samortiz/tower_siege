{
  "name": "tower-siege",
  "version": "1.0.0",
  "private": true,
  "description": "Tower Siege \u2014 web + Android (Capacitor) build",
  "scripts": {
    "serve": "bash scripts/serve.sh",
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "install-apk": "npm run apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
